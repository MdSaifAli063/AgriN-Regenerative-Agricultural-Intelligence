# =============================================================================
# KrishiNet-BRICS (AgriN Commons) - Docker Compose Environment Template
# =============================================================================

# Core settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_MODE=true
LOCAL_NODE_COUNTRY_ISO=IND
NODE_ID=node-ind-icar-01

# Auth & Security
SECRET_KEY=krishinet-brics-super-secret-jwt-key-for-hackathon-2026-brics-cooperation
DEV_AUTH_BYPASS=true

# Database Credentials
POSTGRES_USER=krishi_admin
POSTGRES_PASSWORD=KrishiNetBrics2026!
POSTGRES_DB=krishinet_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO Storage
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=KrishiMinio2026!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=krishinet-media

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# External APIs
GEMINI_API_KEY=
