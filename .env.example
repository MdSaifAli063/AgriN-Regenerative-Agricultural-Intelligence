# =============================================================================
# KrishiNet-BRICS (AgriN Commons) - Environment Configuration Template
# =============================================================================
# Track 4: AgriN & Regenerative Agricultural Intelligence | BRICS Theme: Cooperation
# Copy this file to .env and adjust variables as needed for local or container runs.

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# Environment mode: 'dev', 'development', 'test', 'testing', 'prod', 'production'
ENVIRONMENT=development

# Log verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Hackathon Demo Mode: When true, gracefully falls back to deterministic cached
# and synthetic telemetry if external APIs (Gemini, Copernicus STAC, SoilGrids) are unreachable.
DEMO_MODE=true

# Local sovereign node identifier and ISO country code (IND, BRA, ZAF, etc.)
NODE_ID=node-ind-icar-01
NODE_COUNTRY=IND

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Secret key for local JWT signing (HS256)
SECRET_KEY=krishinet-brics-super-secret-jwt-key-for-hackathon-2026-brics-cooperation
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Fast Dev Auth Bypass: Allows /api/v1/auth/dev-login without Keycloak for rapid testing.
# NOTE: The application will fail-fast with a startup error if enabled when ENVIRONMENT=prod.
DEV_AUTH_BYPASS=true

# Keycloak OIDC Identity Provider Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=krishinet
KEYCLOAK_CLIENT_ID=krishinet-api
KEYCLOAK_CLIENT_SECRET=krishinet-client-secret-dev

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 16 + PostGIS + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=krishi_admin
POSTGRES_PASSWORD=KrishiNetBrics2026!
POSTGRES_DB=krishinet_db
POSTGRES_PORT=5432

# Async connection string for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://krishi_admin:KrishiNetBrics2026!@localhost:5432/krishinet_db

# Sync connection string for Alembic migrations
SYNC_DATABASE_URL=postgresql://krishi_admin:KrishiNetBrics2026!@localhost:5432/krishinet_db

# (Optional fallback for local offline testing without Docker: sqlite+aiosqlite:///./krishinet_dev.db)

# -----------------------------------------------------------------------------
# 4. REDIS & CELERY ASYNC WORKER
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 5. MINIO S3-COMPATIBLE OBJECT STORAGE
# -----------------------------------------------------------------------------
# Used for storing uploaded crop disease photos, NDVI GeoTIFFs, and ML models
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=KrishiMinio2026!
MINIO_BUCKET_NAME=krishinet-media
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# 6. EXTERNAL AI & ENVIRONMENTAL APIs
# -----------------------------------------------------------------------------
# Google Gemini Sovereign AI Engine (Gemini 2.5 Flash / Pro + Text Embedding)
# Obtain free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
USER_DAILY_TOKEN_LIMIT=50000
NODE_DAILY_TOKEN_LIMIT=500000

# Public Sentinel-2 STAC catalog (Primary: Earth Search AWS Element84; Secondary: Copernicus Data Space)
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac


# ISRIC World Soil Information SoilGrids 250m REST API
ISRIC_SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# Open-Meteo High-Resolution Global Numerical Weather Prediction API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# NASA POWER Agroclimatology Solar and Meteorological Archive
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# -----------------------------------------------------------------------------
# 7. NOTIFICATION SERVICES (Optional)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# -----------------------------------------------------------------------------
# 8. BRICS COMMONS FEDERATION & SOVEREIGN DATA RESIDENCY
# -----------------------------------------------------------------------------
# Enable sovereign node federation and cross-border cooperation
FEDERATION_ENABLED=true

# Central BRICS Commons Registry URL
REGISTRY_URL=http://localhost:8010
REGISTRY_PUBLIC_KEY_HEX=

# Sovereign Node Identity (Ed25519)
NODE_KEY_DIR=.node_keys
NODE_ID=node-ind-icar-01
LOCAL_NODE_COUNTRY_ISO=IND
NODE_NAME=India (ICAR / KrishiNet)
NODE_BASE_URL=http://localhost:8000

# Sovereign Egress Gate Security Perimeter
EGRESS_STRICT_MODE=true
MIN_K_ANONYMITY=5
MAX_COORDINATE_DECIMALS=2
LAPLACE_DP_EPSILON=1.0

# Decentralized Flower Federated Learning
FLOWER_NUM_ROUNDS=3
FLOWER_DP_EPSILON=0.50
FLOWER_DP_DELTA=1e-5
FLOWER_CLIP_NORM=1.0
FLOWER_BYZANTINE_DEFENSE=krum

